# Docker Build Arguments for User ID Mapping
# These values map the container node user to your host user
# By default, both are set to 1000 (standard Linux/WSL user)

# On Linux/Mac: Run these commands to get your actual UID/GID
#   export HOST_UID=$(id -u)
#   export HOST_GID=$(id -g)
#   docker-compose build --no-cache jupyter

# On Windows (WSL): Same as Linux/Mac
# On Windows (native): Leave as 1000 or set to your Docker Desktop user ID

HOST_UID=1000
HOST_GID=1000
